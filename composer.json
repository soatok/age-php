{
    "name": "soatok/age",
    "description": "Pure-PHP implementation of the age file encryption format (c2sp.org/age)",
    "keywords": ["age", "cryptography", "encryption"],
    "license": "BSD-3-Clause",
    "type": "library",
    "require": {
        "php": "^8.2",
        "paragonie/constant_time_encoding": "^3",
        "paragonie/hpke": "^0.7",
        "paragonie/pqcrypto_compat": "^0|^1",
        "paragonie/sodium_compat": "^2"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.5",
        "soatok/code-style": ">= 0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^10|^11|^12|^13",
        "vimeo/psalm": "^6"
    },
    "autoload": {
        "psr-4": {
            "Soatok\\Age\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Soatok\\Age\\Tests\\": "tests/"
        }
    },
    "suggest": {
        "ext-pqcrypto": "Better performance and security for post-quantum cryptography"
    },
    "config": {
        "allow-plugins": {
            "infection/extension-installer": true
        }
    }
}
